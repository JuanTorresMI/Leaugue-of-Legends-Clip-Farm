# Riot Games — refresh RIOT_API_KEY every ~24h from https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=americas
RIOT_PLATFORM=na1
RIOT_GAME_NAME=YourRiotName
RIOT_TAG_LINE=NA1

# Filled in during Phase 2 (YouTube)
GOOGLE_CLIENT_SECRETS_PATH=./data/client_secret.json

# Filled in during Phase 3 (Facebook)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Optional: only needed by `python -m clipfarm.cli reauth-facebook` to mint a durable Page token
# that carries read_insights (unlocks Facebook video analytics). Get them at
# https://developers.facebook.com/apps -> your app -> Settings -> Basic. Left blank, reauth prompts.
FB_APP_ID=
FB_APP_SECRET=

# Filled in during Phase 4 (TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
